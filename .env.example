# Copy to .env (never commit .env). Every value here is a placeholder — no real secrets in this file.

NODE_ENV=development
APP_URL=http://localhost:3000

# Postgres 17 + pgvector. Local default matches docker-compose.yml. Production: Neon POOLED connection string.
DATABASE_URL=postgres://lattice:lattice_dev@localhost:54329/lattice

# 32+ random chars.   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters
# base64 of 32 random bytes (AES-256-GCM key for integration secrets).   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-me-base64-of-32-bytes

# Providers: gemini | groq | fake   (fake = deterministic offline mode for dev/tests; refused in production)
LLM_PROVIDER=gemini
EMBED_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Optional chat fallback (Groq has no embeddings)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

LATTICE_ALLOW_FAKE_PROVIDERS=0
LOG_LEVEL=info
